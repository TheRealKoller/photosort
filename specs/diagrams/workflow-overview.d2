# Migriert aus dem bisherigen Mermaid-Flowchart in README.md.
# Siehe ADR specs/decisions/0013-diagram-tooling-d2.md und
# Feature-Spec specs/features/0018-diagram-tooling-migration.md.
# Rendern: scripts/render-diagrams.sh (ruft "d2 --sketch" auf).
#
# Layout bewusst als kompaktes Grid statt einer einzelnen langen Kette pro
# Subgraph (Akzeptanzkriterium "kompakter/weniger vertikaler Platzverbrauch"
# als das bisherige Mermaid-Flowchart) - Inhalt/Knoten/Kanten sind eine reine
# 1:1-Uebersetzung des bisherigen Diagramms, nur die Anordnung ist neu.
#
# Aktualisiert fuer Feature-Spec specs/features/0046-review-agenten-und-pr-workflow-orchestrator.md /
# ADR specs/decisions/0024-review-agenten-und-pr-workflow-beim-orchestrator.md: Review- und
# PR-Knoten liegen jetzt im eigenen "shipfeature"-Subgraph (Orchestrator, Skill ship-feature)
# statt im "implement"-Subgraph (developer) - developer endet stattdessen mit dem
# SendMessage-faehigen Abschlussbericht.
#
# Aktualisiert fuer Feature-Spec specs/features/0059-story-lebenszyklus-github-issues.md /
# ADR specs/decisions/0036-github-issue-natives-story-refinement-inbox-entfaellt.md: der
# bisherige monolithische "refine"-Subgraph (damals idea-sharpener) ist in zwei Subgraphen
# aufgeteilt - "refine" (Skill refinement, faktisch immer/Haiku-lastig, Ergebnis: Story-Issue
# statt Datei) und "sharpen" (Skill spec-writer, reduziert auf Architektur/UX/Test/Security/
# Spec-Anlage, adoptiert das bestehende Issue statt ein neues anzulegen).
#
# Gerendert/verifiziert mit d2 v0.8.1 (https://github.com/d2lang/d2/releases).

direction: right

idea: "Idee / Anforderung" {
  shape: oval
}
capture: "capture:\nGitHub-Issue (Unrefined)"

idea -> capture

refine: "Fachlich schärfen — refinement" {
  grid-columns: 2
  understand: "Verständnis schärfen"
  re: "requirements-engineer:\nRoadmap-Einordnung"
  research: "Code-/Spec-Recherche\n+ Nachfragen"
  devil: "Devil's Advocate"
  story: "Issue: Status Ready" {
    shape: oval
  }

  understand -> re -> research -> devil -> story
}

sharpen: "Technisch planen — spec-writer" {
  grid-columns: 2
  precheck: "Vorbedingung:\nStatus == Ready"
  arch: "architect:\nArchitektur-Ansatz"
  ux: "ux-ui-designer:\nUI/UX-Ansatz"
  testsec: "test-engineer + security-engineer\n(parallel)"
  spec: "Feature-Spec: Accepted\n(Issue adoptiert)" {
    shape: oval
  }

  precheck -> arch -> ux -> testsec -> spec
}

implement: "Umsetzen — developer" {
  grid-columns: 2
  plan: "Umsetzungsplan lesen\n(von architect)"
  tdd: "TDD-Zyklus\n(Rot-Grün-Refactor)"
  quality: "Codequalität prüfen"
  final: "Abschließender Qualitätscheck"
  report: "Abschlussbericht\n(SendMessage-fähig)"

  plan -> tdd -> quality -> final -> report
}

shipfeature: "Nachbereiten — Orchestrator (Skill ship-feature)" {
  grid-columns: 2
  review: "Review, parallel:\ntest-engineer, requirements-engineer\n(faktisch immer) +\nsecurity-engineer*, architect*,\nux-ui-designer* (alle bedingt)"
  fix: "Findings beheben\n(SendMessage an developer)"
  pr: "Pull Request +\nSpec: Implemented" {
    shape: oval
  }

  review -> fix -> pr
}

implement.report -> shipfeature.review

capture -> refine.understand
refine.story -> sharpen.precheck
sharpen.spec -> implement.plan
