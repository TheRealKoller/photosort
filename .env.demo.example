# Demo-.env fuer das lokale Ausprobieren OHNE echten OpenCloud-Server (siehe
# specs/features/0009-local-opencloud-demo-stack.md). Enthaelt bewusst funktionierende
# Demo-Zugangsdaten, kein Geheimnis - anders als .env.example nicht dazu gedacht, echte Werte
# einzutragen.
#
# Verwendung:
#   cp .env.demo.example .env
#   docker compose -f docker-compose.yml -f docker-compose.demo.yml up --build -d
#   docker compose -f docker-compose.yml -f docker-compose.demo.yml --profile seed run --rm seed
#
# NUR LOKAL STARTEN: docker-compose.demo.yml startet zusaetzlich einen echten OpenCloud-Container
# mit bewusst geschwaechter Absicherung (Basic-Auth, bekannte Demo-Zugangsdaten, kein TLS) -
# niemals auf einem gemeinsam genutzten/oeffentlich erreichbaren Host verwenden.

# Postgres
POSTGRES_USER=photosort
POSTGRES_PASSWORD=demo-only-not-a-real-secret
POSTGRES_DB=photosort

# Backend
# Demo-Wert, kein echtes Geheimnis - trotzdem >= 32 Zeichen und ungleich "change-me", damit der
# Startup-Guard (specs/decisions/0005-auth-implementation.md) nicht greift.
SECRET_KEY=local-demo-only-not-a-real-secret-key
BACKEND_PORT=8000
FRONTEND_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
VITE_API_BASE_URL=http://localhost:8000

# PhotoSort-Login (nicht zu verwechseln mit den OpenCloud-Demo-Zugangsdaten unten) - werden beim
# ersten Start per Seed-Migration idempotent angelegt (siehe specs/features/0006-auth.md).
AUTH_SEED_USER1_USERNAME=demo
AUTH_SEED_USER1_PASSWORD=demo-password-1
AUTH_SEED_USER2_USERNAME=demo2
AUTH_SEED_USER2_PASSWORD=demo-password-2

# OpenCloud-Anbindung: zeigt auf den lokalen Demo-Container statt auf eine echte Instanz
# (docker-compose.demo.yml, Service "opencloud-demo"). "alan"/"demo" ist einer der von
# IDM_CREATE_DEMO_USERS=true fest angelegten OpenCloud-Demo-Nutzer (siehe
# specs/architecture/0003-securitykonzept.md). OPENCLOUD_DRIVE_NAME bewusst leer gelassen - das
# Backend waehlt dann automatisch das persoenliche Space des Demo-Nutzers
# (OpenCloudClient.resolve_drive), keine Notwendigkeit, den exakten Space-Namen zu kennen.
OPENCLOUD_BASE_URL=http://opencloud-demo:9200
OPENCLOUD_USERNAME=alan
OPENCLOUD_APP_TOKEN=demo
OPENCLOUD_DRIVE_NAME=

# Optional: Cloud-Sehenswuerdigkeit-Erkennung (specs/features/0047-sehenswuerdigkeit-erkennung-
# cloud-vision-api.md) - fuer das Ausprobieren des Demo-Stacks nicht noetig, da die zugehoerige
# Projekt-Einwilligung ohnehin per Default deaktiviert ist.
ANTHROPIC_API_KEY=
