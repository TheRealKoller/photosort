{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.contract.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  /* Das Projekt der Node-Umgebungs-Tests unter src/ - nicht nur des Design-Vertrags. Beide
     Dateien pruefen Eigenschaften des Repositoriums statt Anwendungsverhalten und brauchen dafuer
     Dateisystem- und Werkzeugzugriff. */
  "include": [
    "src/albumSelection.structure.test.ts",
    "src/photoGridTile.structure.test.ts",
    "src/photoDetail.structure.test.ts",
    "src/designSystem.contrast.contract.test.ts",
    "src/designSystem.tokens.contract.test.ts",
    "src/designSystem.fundstellen.contract.test.ts",
    "src/designSystem.usage.contract.test.ts",
    "src/designSystem.forms.contract.test.ts",
    "src/designSystem.scales.contract.test.ts",
    "src/designSystem.components.contract.test.ts",
    "src/test/designSystemScan.ts",
    "src/prettierSupportInfo.test.ts",
    "src/albumStateLabels.structure.test.ts",
    "src/albumDraftMembership.contract.test.ts",
    "src/stepName.structure.test.ts",
    "src/workflowOverview.structure.test.ts",
    "src/serviceWorker.build.test.ts"
  ]
}
