{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  /* TEMPORAER (specs/features/0287-design-richtungen-vergleich.md): das Schutzgelaender des
     Design-Labors liest Dateien per `node:fs` und braucht deshalb dieses Projekt mit
     "types": ["node"]. Mit dem Labor wieder zu entfernen. */
  "include": ["vite.config.ts", "design-lab/guards.test.ts"]
}
