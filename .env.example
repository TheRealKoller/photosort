# Postgres
POSTGRES_USER=photosort
POSTGRES_PASSWORD=change-me
POSTGRES_DB=photosort

# Backend
# SECRET_KEY signiert auch die Login-JWTs (siehe specs/decisions/0005-auth-implementation.md) -
# in Produktion zwingend auf einen zufaelligen, geheimen Wert setzen.
SECRET_KEY=change-me
BACKEND_PORT=8000
FRONTEND_PORT=8080
# Erlaubte Frontend-Origins fuer CORS, komma-getrennt, kein Wildcard (siehe
# specs/features/0005-minimal-project-frontend.md, architecture/0003-securitykonzept.md).
# Default deckt lokale Entwicklung ab (Vite-Dev-Server, docker-compose-Frontend) - in
# Produktion auf die tatsaechliche(n) oeffentlich erreichbare(n) Frontend-Origin(s) setzen.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# Frontend: Basis-URL der Backend-API, aus dem Browser heraus erreichbar (nicht der interne
# Compose-Service-Name). Wird zur Build-Zeit ins statische Frontend-Bundle eingebacken (Vite,
# siehe frontend/src/api/client.ts). Default passt zum lokalen "docker compose up --build"
# ohne Reverse-Proxy (Frontend auf FRONTEND_PORT, Backend direkt auf BACKEND_PORT erreichbar) -
# in Produktion leer lassen, wenn Frontend und Backend stattdessen hinter demselben
# Reverse-Proxy-Origin liegen (relative Requests genuegen dann).
VITE_API_BASE_URL=http://localhost:8000

# Initiale Benutzerkonten (Seed-Migration legt sie beim Deploy idempotent an,
# siehe specs/features/0006-auth.md). Nur beim allerersten Anlegen wirksam -
# spaeter aendert die Migration bestehende Passwoerter nicht mehr.
AUTH_SEED_USER1_USERNAME=daniel
AUTH_SEED_USER1_PASSWORD=change-me
AUTH_SEED_USER2_USERNAME=change-me
AUTH_SEED_USER2_PASSWORD=change-me

# OpenCloud-Anbindung (siehe specs/features/0001-opencloud-project-connection.md)
# Eine gemeinsame Verbindung für beide Nutzer; App-Token in OpenCloud unter
# Einstellungen -> App-Tokens erzeugen (siehe docs.opencloud.eu/docs/user/admin/app-tokens).
OPENCLOUD_BASE_URL=
OPENCLOUD_USERNAME=
OPENCLOUD_APP_TOKEN=
# Name des OpenCloud-Space (Drive), der durchsucht wird, z.B. "Family".
# Sichtbare Namen: GET {OPENCLOUD_BASE_URL}/graph/v1.0/me/drives
OPENCLOUD_DRIVE_NAME=

# Optional: Cloud-KI-Bewertung (Phase B, siehe specs/decisions/0002-hybrid-ai-scoring.md).
# Leer lassen, um Phase B zu deaktivieren.
ANTHROPIC_API_KEY=

# Lokale Top-Foto-Auswahl mit Kategorie-Mix (specs/features/0024-top-photo-selection-category-
# mix.md, decisions/0015-lokale-kategorie-klassifikation.md) - rein lokal/kostenlos (mediapipe +
# Pillow-Heuristik), Default an. Auf false setzen, um POST /projects/{id}/select-top zu sperren
# (403), ohne die Funktion aus dem Code zu entfernen.
CATEGORY_SELECTION_ENABLED=true

# Obergrenze fuer die begrenzte Parallelisierung von Download + Thumbnail-Erzeugung beim Scan
# (specs/features/0036-scan-performance-zweiphasig-parallel.md, decisions/0020-scan-enumeration-
# und-parallele-verarbeitung.md) - Betriebsparameter gegen Ueberlastung des Einzelnutzer-
# Homeserver-OpenCloud, muss >= 1 sein. Default 4.
SCAN_DOWNLOAD_CONCURRENCY=4

# Obergrenze fuer die begrenzte Parallelisierung der pro-Unterordner-Bilddatei-Zaehlung im
# Ordner-Browser (specs/features/0050-dateianzahl-im-ordner-browser.md, decisions/0028-ordner-
# browser-bilddatei-zaehlung.md) - Betriebsparameter gegen Ueberlastung des Einzelnutzer-
# Homeserver-OpenCloud, muss >= 1 sein. Default 4.
OPENCLOUD_FOLDER_COUNT_CONCURRENCY=4
